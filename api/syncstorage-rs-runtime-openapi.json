{
  "openapi": "3.1.0",
  "info": {
    "title": "syncstorage-rs Runtime API (reconstructed)",
    "version": "master-2026-09-28",
    "description": "Reconstructed from the runtime Actix routes, handlers and request extractors of mozilla-services/syncstorage-rs master. This is not an upstream Mozilla artifact."
  },
  "tags": [
    {
      "name": "syncstorage",
      "description": "Firefox Sync Storage API 1.5"
    },
    {
      "name": "tokenserver",
      "description": "Tokenserver routes, enabled conditionally"
    },
    {
      "name": "fxa-webhook",
      "description": "FxA webhook, enabled conditionally"
    },
    {
      "name": "dockerflow",
      "description": "Operational endpoints"
    },
    {
      "name": "documentation",
      "description": "Runtime OpenAPI/Swagger endpoints"
    }
  ],
  "components": {
    "securitySchemes": {
      "Hawk": {
        "type": "http",
        "scheme": "hawk",
        "description": "HAWK Authorization used by SyncStorage"
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token used by Tokenserver/FxA-facing flows"
      }
    },
    "parameters": {
      "Uid": {
        "name": "uid",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{1,10}$"
        }
      },
      "Collection": {
        "name": "collection",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "BsoId": {
        "name": "bso",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "IfModifiedSince": {
        "name": "X-If-Modified-Since",
        "in": "header",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/SyncTimestamp"
        }
      },
      "IfUnmodifiedSince": {
        "name": "X-If-Unmodified-Since",
        "in": "header",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/SyncTimestamp"
        }
      }
    },
    "headers": {
      "XWeaveTimestamp": {
        "schema": {
          "$ref": "#/components/schemas/SyncTimestamp"
        },
        "description": "Server timestamp added by middleware."
      },
      "XLastModified": {
        "schema": {
          "$ref": "#/components/schemas/SyncTimestamp"
        },
        "description": "Last-modified timestamp for the relevant storage scope."
      },
      "XWeaveNextOffset": {
        "schema": {
          "type": "string"
        },
        "description": "Opaque pagination offset for the next page."
      },
      "XWeaveRecords": {
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XWeaveBytes": {
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XWeaveTotalRecords": {
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XWeaveTotalBytes": {
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "schemas": {
      "SyncTimestamp": {
        "type": "number",
        "format": "double",
        "minimum": 0,
        "description": "Epoch seconds; Sync uses decimal timestamps."
      },
      "BSO": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "modified": {
            "$ref": "#/components/schemas/SyncTimestamp"
          },
          "sortindex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "payload": {
            "type": [
              "string",
              "null"
            ]
          },
          "ttl": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "BSOWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sortindex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "payload": {
            "type": [
              "string",
              "null"
            ]
          },
          "ttl": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "CollectionTimestamps": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/SyncTimestamp"
        }
      },
      "CollectionCounts": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      },
      "CollectionUsage": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0
        },
        "description": "Per-collection usage in KiB."
      },
      "PostResult": {
        "type": "object",
        "properties": {
          "modified": {
            "$ref": "#/components/schemas/SyncTimestamp"
          },
          "success": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failed": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Quota": {
        "type": "array",
        "prefixItems": [
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": [
              "number",
              "null"
            ]
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "LegacyError": {
        "oneOf": [
          {
            "type": "integer",
            "enum": [
              0
            ]
          },
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ],
        "description": "syncstorage-rs preserves legacy Sync error bodies for several validation/error paths."
      }
    }
  },
